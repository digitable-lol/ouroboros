#!/usr/bin/env bash
#
# asdf зовёт этот файл, чтобы поставить скачанное.
# Берёт то, что положил bin/download, и раскладывает в $ASDF_INSTALL_PATH так,
# чтобы внутри оказался каталог bin/ — asdf показывает наружу только его.
#
# Что даёт asdf:
#   ASDF_INSTALL_TYPE     version или ref
#   ASDF_INSTALL_VERSION  сам номер версии
#   ASDF_INSTALL_PATH     куда ставить
#   ASDF_DOWNLOAD_PATH    что поставить (сюда скачал bin/download)
#
set -euo pipefail

readonly install_path="${ASDF_INSTALL_PATH:?asdf не передал ASDF_INSTALL_PATH}"
readonly download_path="${ASDF_DOWNLOAD_PATH:?asdf не передал ASDF_DOWNLOAD_PATH}"

if [[ "${ASDF_INSTALL_TYPE:-version}" != "version" ]]; then
  echo "asdf-ouroboros: установка по ref не поддерживается, назовите версию" >&2
  exit 1
fi

if [[ ! -f "${download_path}/pyproject.toml" ]]; then
  echo "asdf-ouroboros: нечего ставить — в ${download_path} нет pyproject.toml." >&2
  echo "asdf-ouroboros: сперва отрабатывает bin/download." >&2
  exit 1
fi

# Пакет требует Python 3.12 или новее (pyproject.toml, requires-python).
# Проверяем до установки: иначе человек узнает об этом из невнятной ошибки сборки.
python_bin=""
for candidate in python3.14 python3.13 python3.12 python3; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
    python_bin="$(command -v "$candidate")"
    break
  fi
done
if [[ -z "$python_bin" ]]; then
  echo "asdf-ouroboros: не найден Python 3.12 или новее." >&2
  exit 1
fi

mkdir -p "${install_path}/bin"

# Пакет ставится в собственное окружение внутри каталога версии, а наружу
# выносятся только его команды. Так у каждой версии свои зависимости и они не
# сталкиваются ни между собой, ни с системным Python.
echo "asdf-ouroboros: ставлю из исходников (${python_bin})"
"$python_bin" -m venv "${install_path}/libexec"
"${install_path}/libexec/bin/python" -m pip install --quiet --upgrade pip
"${install_path}/libexec/bin/python" -m pip install --quiet "${download_path}"

# Наружу выносится всё, что пакет положил в bin своего окружения, кроме
# служебного питоновского. Сейчас это ouroboros и ouroboros-mcp; если выпуск
# добавит команды, они подхватятся сами.
shopt -s nullglob
for entry in "${install_path}/libexec/bin/"*; do
  name="$(basename "$entry")"
  case "$name" in
    python*|pip*|activate*|Activate*) continue ;;
  esac
  ln -sf "../libexec/bin/${name}" "${install_path}/bin/${name}"
done
shopt -u nullglob

if [[ ! -x "${install_path}/bin/ouroboros" ]]; then
  echo "asdf-ouroboros: поставилось не то — ${install_path}/bin/ouroboros отсутствует" >&2
  exit 1
fi

# Проверка, что поставленное запускается, а не просто лежит на месте.
if ! "${install_path}/bin/ouroboros" languages >/dev/null; then
  echo "asdf-ouroboros: поставленный ouroboros не запускается" >&2
  exit 1
fi

echo "asdf-ouroboros: готово, версия ${ASDF_INSTALL_VERSION:-?}"

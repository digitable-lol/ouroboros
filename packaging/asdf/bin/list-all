#!/usr/bin/env bash
#
# asdf зовёт этот файл, чтобы узнать список версий.
# Печатает их в стандартный вывод одной строкой, через пробел, от старых к новым.
#
set -euo pipefail

# Хранилище, на тегах которого стоят номера версий.
# Проставлено: адрес известен и меняться не должен.
readonly REPO="https://github.com/digitable-lol/ouroboros.git"

# Теги вида v1.2.3 → номера вида 1.2.3.
# Если тегов ещё нет, вывод пустой — и это правда, а не поломка: выпусков нет.
# asdf в таком случае скажет, что версия не найдена; см. README.md рядом.
git ls-remote --tags --refs "$REPO" \
  | awk -F/ '{ print $NF }' \
  | sed 's/^v//' \
  | grep -E '^[0-9]+\.[0-9]+(\.[0-9]+)?' \
  | sort -V \
  | tr '\n' ' '

echo
